{
  "name": "wxt-react-starter",
  "description": "manifest.json description",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt -b chrome --mv3",
    "dev:brave": "wxt -b chrome --mv3",
    "dev:firefox": "wxt -b firefox --mv3",

    "build": "wxt build -b chrome --mv3",
    "build:brave": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv3",

    "zip": "wxt zip -b chrome --mv3",
    "zip:brave": "wxt zip -b chrome --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",

    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
    },
    "dependencies": {
      "react": "^19.2.4",
      "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^7.0.2",
    "vite": "^8",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
